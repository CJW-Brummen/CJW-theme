{
  "name": "cjw-theme-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint \"js/**/*.js\"",
    "lint:css": "stylelint \"sass/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:css",
    "watch": "sass --watch sass:. --style=expanded",
    "compile:css": "sass sass:. --style=expanded --no-source-map",
    "compile:rtl": "rtlcss style.css style-rtl.css",
    "bundle": "dir-archiver --src . --dest ../cjw-theme.zip --exclude .DS_Store .editorconfig .git .gitattributes .github .gitignore .idea .php-cs-fixer.dist.php README.md composer.json composer.lock eslint.config.js node_modules package-lock.json package.json phpcs.xml.dist phpstan-bootstrap.php phpstan.neon.dist sass style.css.map vendor yarn.lock"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dir-archiver": "^3.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "rtlcss": "^4.3.0",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "ignoreFiles": [
      "**/*.min.css",
      "style.css",
      "style-rtl.css",
      "woocommerce.css",
      "sass/generic/_normalize.scss"
    ],
    "rules": {
      "alpha-value-notation": null,
      "color-function-alias-notation": null,
      "color-function-notation": null,
      "color-hex-length": null,
      "custom-property-pattern": null,
      "declaration-block-single-line-max-declarations": null,
      "keyframes-name-pattern": null,
      "keyframe-selector-notation": null,
      "media-feature-range-notation": null,
      "rule-empty-line-before": null,
      "selector-class-pattern": null
    }
  }
}
