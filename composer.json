{
  "name": "cjw-brummen/cjw-theme",
  "description": "CJW Brummen WordPress theme, based on underscores (_s).",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "friendsofphp/php-cs-fixer": "^3.95.17",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.2.6",
    "phpunit/phpunit": "^13.2.5",
    "szepeviktor/phpstan-wordpress": "^2.0.3",
    "wp-cli/i18n-command": "^2.7",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "parallel-lint --exclude vendor --exclude node_modules .",
    "phpcs": "phpcs --standard=phpcs.xml.dist --extensions=php --colors -p .",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist --extensions=php -p .",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff --verbose",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff --dry-run --verbose",
    "analyze": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=2G",
    "analyze:github": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=2G --error-format=github",
    "test": "phpunit --configuration phpunit.xml.dist",
    "security": "@composer audit --locked",
    "make-pot": "wp i18n make-pot . languages/cjw-brummen.pot --domain=cjw-brummen --exclude=.stubs,node_modules,tests,vendor",
    "check": [
      "@security",
      "@lint",
      "@phpcs",
      "@format:check",
      "@analyze",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "lint": "Parse every PHP file for syntax errors.",
    "phpcs": "WordPress coding standards and PHP compatibility.",
    "phpcbf": "Auto-fix what phpcs can fix.",
    "format": "Apply the PHP-CS-Fixer ruleset.",
    "format:check": "Report formatting drift without writing.",
    "analyze": "PHPStan static analysis.",
    "analyze:github": "PHPStan with GitHub Actions annotations.",
    "test": "Run the PHPUnit suite.",
    "security": "Audit composer.lock against the advisory database.",
    "make-pot": "Regenerate the translation template.",
    "check": "Everything CI runs, in CI's order."
  }
}
