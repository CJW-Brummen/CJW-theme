{
  "name": "cjw-brummen/cjw-theme",
  "description": "CJW Brummen WordPress theme, based on underscores (_s).",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "enlightn/security-checker": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/woocommerce-stubs": "^10.9",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-cli/i18n-command": "^2.2.5",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "analyze:github": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G --error-format=github",
    "lint": "parallel-lint --exclude vendor --exclude node_modules .",
    "phpcs": "phpcs --standard=phpcs.xml.dist --extensions=php --colors -p .",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist --extensions=php -p .",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff --verbose",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --diff --dry-run --verbose",
    "analyze": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=1G",
    "security": "security-checker security:check composer.lock",
    "make-pot": "wp i18n make-pot . languages/cjw-brummen.pot",
    "check": [
      "@lint",
      "@phpcs",
      "@format:check",
      "@analyze",
      "@security"
    ]
  }
}
