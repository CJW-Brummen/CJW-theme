{
    // Shared verbatim by CJW-theme and CJW-plugin. Change one, change the other.
    //
    // ─── Scope note (read this before debugging "my setting does nothing") ────
    //
    // VS Code settings have a scope. Only `resource`-scoped ones can be set in a
    // folder's .vscode/settings.json while a multi-root .code-workspace is open;
    // `window`-scoped ones are ignored there and VS Code marks them "This setting
    // cannot be applied in this workspace." The window-scoped keys in this file —
    //   intelephense.files.maxSize, intelephense.environment.phpVersion,
    //   php.suggest.basic, php.validate.enable, every php-cs-fixer.*
    // — therefore only take effect when this folder is opened on its own. They are
    // kept here for exactly that case, and mirrored in CJW.code-workspace for the
    // multi-root setup. Change one, change the other.
    //
    // Resource-scoped and so always live: intelephense.files.exclude, phpcs.*,
    // the [php] block, files.exclude, search.exclude.

    // ─── Intelephense (PHP IntelliSense) ──────────────────────────────────────
    //
    // Both repositories ship the stubs that describe what they call:
    //   vendor/php-stubs/wordpress-stubs/wordpress-stubs.php  (~5 MB, both)
    //   .stubs/                                               (cross-repo API, per repo)
    //
    // Intelephense silently skips any file larger than `files.maxSize`, which
    // defaults to 1 MB — so WordPress itself was never indexed and every
    // `get_the_title()` call had no completion, hover, signature help or
    // go-to-definition. Raising the limit past the largest stub is the fix.
    "intelephense.files.maxSize": 8000000,

    // Match composer.json ("php": ">=8.5") so 8.5 syntax and stdlib signatures resolve.
    "intelephense.environment.phpVersion": "8.5.0",

    // Everything below `vendor/` except php-stubs/ and phpunit/ is CI tooling
    // (PHPStan, PHPCS, WPCS, PHP-CS-Fixer, wp-cli) that neither repository calls.
    // Skipping it keeps the initial index fast and keeps sniff/rule classes out of
    // completion lists. The first ten entries are Intelephense's own defaults —
    // setting this key replaces them wholesale, so they have to be repeated.
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**",
        "**/CVS/**",
        "**/.DS_Store/**",
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**/{Tests,tests}/**",
        "**/.history/**",
        "**/vendor/**/vendor/**",
        "**/vendor/phpstan/**",
        "**/vendor/squizlabs/**",
        "**/vendor/phpcsstandards/**",
        "**/vendor/phpcompatibility/**",
        "**/vendor/wp-coding-standards/**",
        "**/vendor/friendsofphp/**",
        "**/vendor/symfony/**",
        "**/vendor/wp-cli/**",
        "**/vendor/php-parallel-lint/**",
        "**/vendor/dealerdirect/**",
        "**/vendor/nikic/**",
        "**/vendor/phar-io/**",
        "**/vendor/sebastian/**",
        "**/vendor/theseer/**"
    ],

    // VS Code's built-in PHP support only does word-based suggestions and would
    // outrank Intelephense's; its validator would also double-report syntax errors
    // Intelephense already reports. Both are off per Intelephense's own guidance.
    "php.suggest.basic": false,
    "php.validate.enable": false,

    // ─── PHPCS (ikappas.phpcs) ────────────────────────────────────────────────
    //
    // executablePath is deliberately unset: the extension then resolves phpcs
    // through composer.json to ./vendor/bin/phpcs, which stays correct on any
    // machine. autoConfigSearch picks up phpcs.xml.dist from the repository root,
    // so the editor reports exactly what `composer phpcs` reports in CI.
    "phpcs.enable": true,
    "phpcs.autoConfigSearch": true,
    "phpcs.showSources": true,
    "phpcs.ignorePatterns": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/assets/**",
        "**/tests/**",
        "**/.stubs/**"
    ],

    // ─── PHP-CS-Fixer (junstyle.php-cs-fixer) ─────────────────────────────────
    //
    // Use the repository's pinned binary and config instead of the extension's
    // bundled phar and its @PSR12 default — the theme's config intentionally
    // disables the indentation rules that would otherwise flatten the mixed
    // PHP/HTML templates (see the comments in .php-cs-fixer.dist.php).
    // `rules` must stay empty so the config file is the single source of truth.
    "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
    "php-cs-fixer.config": ".php-cs-fixer.dist.php",
    "php-cs-fixer.rules": "",
    "php-cs-fixer.allowRisky": false,
    "php-cs-fixer.formatHtml": false,
    "php-cs-fixer.onsave": false,
    // Applies to the "PHP CS Fixer: fix" command (the formatter itself always runs
    // through a temp file and forces override): intersection makes an explicit fix
    // on .stubs/, assets/ or vendor/ a no-op, matching `composer format`.
    "php-cs-fixer.pathMode": "intersection",

    "[php]": {
        "editor.defaultFormatter": "junstyle.php-cs-fixer",
        "editor.formatOnSave": false
    },

    // ─── Misc ─────────────────────────────────────────────────────────────────
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.php-cs-fixer.cache": true,
        "**/.phpunit.cache": true
    },
    "search.exclude": {
        "**/vendor": true,
        "**/node_modules": true
    }
}
